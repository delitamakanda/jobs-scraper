{
  "mcpServers": {
    "playwright": {
      "command": "playwright-mcp",
      "args": [
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--device",
        "iPhone 13",
        "--caps",
        "testing",
        "--allowed-origins",
        "http://localhost:4200;http://localhost:8000",
        "--output-dir",
        ".agent-out/playwright"
      ]
    }
  }
}
