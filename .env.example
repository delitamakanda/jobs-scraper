# Copy to .env (never commit it): cp .env.example .env
# Without a real key the app starts, but AI features (analysis, import, matching,
# cover letters) fail.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

# Optional
# DJANGO_LOG_LEVEL=INFO
# Extra allowed hosts, comma-separated (docker-compose already adds "api")
# DJANGO_ALLOWED_HOSTS=api
# SQLite file location (docker-compose sets it to /data/db.sqlite3)
# SQLITE_PATH=
